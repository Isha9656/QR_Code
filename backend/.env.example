# =====================================================================
# INTERNAL QR MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION
# =====================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env` (or `copy .env.example .env`)
# 2. In production, set ENVIRONMENT=production and generate a strong SECRET_KEY.
# 3. Never commit .env containing real production secrets to version control.
# =====================================================================

# Environment Mode: 'development' or 'production'
# In production, the system blocks default development keys and enforces strict security.
ENVIRONMENT=development

# Application Base URL (This is embedded in printed QR codes: {BASE_URL}/q/{token})
# Production Example: https://qr.internal.company.com
BASE_URL=http://localhost:8000

# Database Configuration
# SQLite (Standard internal deployment):
DATABASE_URL=sqlite:///./qr_system.db
# PostgreSQL (High-concurrency / multi-node deployment):
# DATABASE_URL=postgresql://user:STRONG_PASSWORD_HERE@localhost:5432/qr_system

# JWT Secret Key (MANDATORY IN PRODUCTION)
# Generate with: openssl rand -hex 32  OR  python -c "import secrets; print(secrets.token_hex(32))"
# Example placeholder (do not use in production):
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32

# Token Expiration in minutes (Default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
# Production Example: https://qr.internal.company.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Rate Limiting Policies
ENABLE_RATE_LIMITING=true
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_GENERAL=60/minute

# Role-Based Access Control Policies
# Set to 'false' if administrators wish to temporarily freeze operator assignments
OPERATOR_CAN_ASSIGN=true
