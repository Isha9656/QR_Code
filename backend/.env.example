# Environment Configuration
# Copy this to .env and modify values

# Application base URL (used in QR codes)
BASE_URL=http://localhost:8000

# Database URL
# SQLite (development):
DATABASE_URL=sqlite:///./qr_system.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/qr_system

# JWT Secret Key - CHANGE THIS IN PRODUCTION
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
